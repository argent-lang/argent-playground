import "./smt.ag";
import actor Name from "./name.ag";

state RegistryState {
    byte[32] root;
}

actor Registry owns RegistryState {
    entry register(label: byte[63], label_len: int, owner: pubkey, owner_sig: sig) emits {
        registry: Registry;
        name: Name;
    } {
        require(checkSig(owner_sig, owner));
        require(label_is_valid(label, label_len));

        byte[32] key = name_key(self.covenant_id, label, label_len);
        byte[32] next_root = inserted_root(root, key);
        RegistryState next_registry = {
            root: next_root,
        };
        NameState minted_name = {
            name_key: key,
            label: label,
            label_len: label_len,
            owner: owner,
        };

        // value continuation
        require(registry.value == self.value);

        become {
            registry <- Registry(next_registry);
            name <- Name(minted_name);
        };
    }
}
