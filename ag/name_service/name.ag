state NameState {
    byte[32] name_key;
    byte[63] label;
    pubkey owner;
}

actor Name owns NameState {
    entry transfer(pubkey next_owner, sig owner_sig) emits next: Name {
        require(checkSig(owner_sig, owner));

        NameState transferred = {
            name_key: name_key,
            label: label,
            owner: next_owner,
        };
        unrestricted(next.value);
        become next <- Name(transferred);
    }

    // useful to compose with this NFT from another app
    // e.g.: another covenant can require me to be the owner by co-spending it
    entry continue(sig owner_sig) emits next: Name {
        require(checkSig(owner_sig, owner));

        unrestricted(next.value);
        become next <- Name(self.state);
    }
}
