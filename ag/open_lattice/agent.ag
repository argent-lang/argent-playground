// Open Lattice — Season 0 agent app.
//
// Independently deployed agent contracts. `Agent` is the generic capsule
// holder: it authorizes any world transition the controller cell co-signs
// while preserving its own identity fields. `perish` is the death path — the
// covenant ends with no successor, which only the world controller can lead.

import "./core.ag";

state ForagerStrategy {
    int hunger;
    int mood;
    byte[32] target_agent_id;
}

state ForagerState expands AgentCapsule {
    strategy: ForagerStrategy;
}

actor Agent owns AgentCapsule {
    entry step(next_agent: AgentCapsule) emits {
        agent: Agent;
    } {
        require(controller_id.authorized());
        require(next_agent.world_id == world_id);
        require(next_agent.agent_id == agent_id);
        require(next_agent.species_id == species_id);
        require(next_agent.controller_id == controller_id);
        require(next_agent.capabilities_digest == capabilities_digest);
        require(next_agent.strategy == strategy);
        require(next_agent.generation == generation);

        become agent <- Agent(next_agent);
    }

    entry perish() emits none {
        require(controller_id.authorized());
        require(energy == 0);
    }
}

actor Forager owns ForagerState {
    entry step(next_x: int, next_y: int, next_energy: int) emits {
        agent: Forager;
    } {
        require(controller_id.authorized());
        require(next_energy == energy - 1);
        require(next_energy >= 0);

        ForagerState next_agent = {
            world_id: world_id,
            agent_id: agent_id,
            species_id: species_id,
            controller_id: controller_id,
            capabilities_digest: capabilities_digest,
            strategy: ForagerStrategy {
                hunger: strategy.hunger + 1,
                mood: strategy.mood,
                target_agent_id: strategy.target_agent_id,
            },
            x: next_x,
            y: next_y,
            energy: next_energy,
            generation: generation,
        };

        become agent <- Forager(next_agent);
    }
}

app OpenLatticeAgent {
    actor Agent;
    actor Forager;
}
