import "./core.ag";

actor Forager owns AgentCapsule {
    entry step(int next_energy) emits {
        agent: Forager,
    } {
        require(next_energy == energy - 1);
        require(next_energy >= 0);

        AgentCapsule next_agent = {
            energy: next_energy,
        };

        unrestricted(agent.value);
        become agent <- Forager(next_agent);
    }
}

app Agents {
    actor Forager;
}
