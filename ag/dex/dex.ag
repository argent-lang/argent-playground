import "./capsule.ag";
import "./dex_registry.ag";

// Core and Pair share source types while compiling as independent apps and
// launching under independent covenant ids.

// The core commits to one Pair implementation through authored capsule state.
// Each registration genesis-creates a distinct Pair covenant using that handle.
state DexCoreCapsule {
    pubkey governor;
    actor_type<DexCoreCapsule> core_type;
    actor_type<DexPairState> pair_type;

    // Pair apps bind to a stable, fixed-size Core handle instead of carrying
    // the full registry bytes in that handle. The capsule exposes only this
    // digest; DexCoreState expands it into the typed registry used by Core.
    // Reserve moves still understand and prove its current preimage.
    virtual pairs;
}

state DexCoreState expands DexCoreCapsule {
    pairs: PairRegistry;
}

state DexPairState {
    pubkey initializer;
    bool initialized;

    cov_id core_id;
    actor_type<DexCoreCapsule> core_type;

    cov_id quote_id;
    actor_type<AssetCapsule> quote_type;
    cov_id base_id;
    actor_type<AssetCapsule> base_type;

    int quote_per_base_num;
    int quote_per_base_den;
    int swaps;
    int reserve_moves;
}

// DexCore is touched only for pair registration and reserve migration. Normal
// swaps do not contend on this actor.
actor DexCore owns DexCoreState {
    // Registration creates the Pair covenant directly from this Core input.
    // The generated genesis check binds pair_id to the exact Pair output while
    // the actor_type handle fixes the externally auditable Pair implementation.
    entry register_pair(
        pubkey initializer,
        cov_id quote_id,
        actor_type<AssetCapsule> quote_type,
        cov_id base_id,
        actor_type<AssetCapsule> base_type,
        int quote_per_base_num,
        int quote_per_base_den,
        sig governor_sig
    )
    spawns new_pair by pair_id {
        outputs {
            pair: self.pair_type,
        }
    }
    emits next: DexCore {
        require(checkSig(governor_sig, pubkey(governor)));
        require(quote_id != base_id);
        require(quote_per_base_num > 0);
        require(quote_per_base_den > 0);
        require(pairs.count >= 0);
        require(pairs.count < MAX_PAIRS);
        require(!registry_contains_pair(pairs.records, pairs.count, pair_id));

        int offset = pairs.count * PAIR_RECORD_BYTES;
        byte[384] next_records = byte[384](
            pairs.records.slice(0, offset)
                + byte[](pair_id)
                + byte[](quote_id)
                + byte[](base_id)
                + pairs.records.slice(offset + PAIR_RECORD_BYTES, PAIR_RECORDS_BYTES)
        );

        DexPairState pair_state = {
            initializer: initializer,
            initialized: true,
            core_id: self.cov_id,
            core_type: core_type,
            quote_id: quote_id,
            quote_type: quote_type,
            base_id: base_id,
            base_type: base_type,
            quote_per_base_num: quote_per_base_num,
            quote_per_base_den: quote_per_base_den,
            swaps: 0,
            reserve_moves: 0,
        };

        unrestricted(new_pair.outputs.pair.value);
        require new_pair.outputs become {
            pair <- self.pair_type(pair_state),
        };

        DexCoreState next_core = {
            governor: governor,
            core_type: core_type,
            pair_type: pair_type,
            pairs: PairRegistry {
                records: next_records,
                count: pairs.count + 1,
            },
        };

        require(next.value == self.value);
        become next <- DexCore(next_core);
    }

    // Reserve migration reads the current registry through this unchanged core
    // input/output pair. The linear preimage is supplied to the migrating Pair.
    entry witness_registry() emits next: DexCore {
        require(next.value == self.value);
        become next <- self;
    }
}

actor DexPair owns DexPairState {
    // A swap consumes Pair + quote payment + base reserve and creates
    // Pair + quote reserve + base payout. Local names describe those roles;
    // base/quote remain the persistent pair identity.
    entry swap()
    observes quote by self.quote_id {
        inputs {
            payment: self.quote_type,
        }
        outputs {
            reserve: self.quote_type,
        }
    }
    observes base by self.base_id {
        inputs {
            reserve: self.base_type,
        }
        outputs {
            payout: self.base_type,
        }
    }
    emits next: DexPair {
        require(initialized);

        AssetCapsule quote_payment = state(quote.inputs.payment);
        AssetCapsule base_reserve = state(base.inputs.reserve);

        require(quote_payment.owner_kind == OWNER_KEY);
        require(base_reserve.owner_kind == OWNER_COVID);
        require(base_reserve.owner == byte[32](self.cov_id));
        require(quote_payment.amount > 0);
        require(base_reserve.amount > 0);

        // One base unit costs quote_per_base_num / quote_per_base_den quote
        // units. Whole-lot transfers avoid rounding in this first DEX model.
        require(
            quote_payment.amount * quote_per_base_den
                == base_reserve.amount * quote_per_base_num
        );

        AssetCapsule quote_reserve = {
            owner: byte[32](self.cov_id),
            owner_kind: OWNER_COVID,
            policy: quote_payment.policy,
            amount: quote_payment.amount,
        };

        AssetCapsule base_payout = {
            owner: quote_payment.owner,
            owner_kind: OWNER_KEY,
            policy: base_reserve.policy,
            amount: base_reserve.amount,
        };

        require quote.outputs become {
            reserve <- self.quote_type(quote_reserve),
        };
        require base.outputs become {
            payout <- self.base_type(base_payout),
        };

        DexPairState next_pair = {
            initializer: initializer,
            initialized: initialized,
            core_id: core_id,
            core_type: core_type,
            quote_id: quote_id,
            quote_type: quote_type,
            base_id: base_id,
            base_type: base_type,
            quote_per_base_num: quote_per_base_num,
            quote_per_base_den: quote_per_base_den,
            swaps: swaps + 1,
            reserve_moves: reserve_moves,
        };

        // KAS fees, partial fills, change lots, and slippage are outside this
        // demo. The asset and ownership invariants do not depend on them.
        require(next.value == self.value);
        become next <- DexPair(next_pair);
    }

    // Moving either reserve to another Pair requires a current Core registry
    // proof that the target Pair is registered for the selected asset.
    entry move_reserve(
        cov_id asset_id,
        cov_id target_pair_id,
        int target_pair_index,
        byte[392] registry_preimage
    )
    observes registry by self.core_id {
        inputs {
            core: self.core_type,
        }
        outputs {
            core: self.core_type,
        }
    }
    observes moved_asset by asset_id {
        inputs {
            reserve: actor_type<AssetCapsule> as asset_type,
        }
        outputs {
            reserve: asset_type,
        }
    }
    emits next: DexPair {
        require(initialized);
        require(target_pair_id != self.cov_id);
        require(
            (asset_id == quote_id && asset_type == quote_type)
                || (asset_id == base_id && asset_type == base_type)
        );

        DexCoreCapsule core_state = state(registry.inputs.core);
        require(blake3(byte[](registry_preimage)) == core_state.pairs);
        require(registry_authorizes_asset(
            registry_preimage,
            target_pair_index,
            target_pair_id,
            asset_id
        ));

        AssetCapsule reserve_state = state(moved_asset.inputs.reserve);
        require(reserve_state.owner_kind == OWNER_COVID);
        require(reserve_state.owner == byte[32](self.cov_id));

        AssetCapsule moved_reserve = {
            owner: byte[32](target_pair_id),
            owner_kind: OWNER_COVID,
            policy: reserve_state.policy,
            amount: reserve_state.amount,
        };

        require registry.outputs become {
            core <- self.core_type(core_state),
        };
        require moved_asset.outputs become {
            reserve <- asset_type(moved_reserve),
        };

        DexPairState next_pair = {
            initializer: initializer,
            initialized: initialized,
            core_id: core_id,
            core_type: core_type,
            quote_id: quote_id,
            quote_type: quote_type,
            base_id: base_id,
            base_type: base_type,
            quote_per_base_num: quote_per_base_num,
            quote_per_base_den: quote_per_base_den,
            swaps: swaps,
            reserve_moves: reserve_moves + 1,
        };

        require(next.value == self.value);
        become next <- DexPair(next_pair);
    }
}

app Dexc {
    actor DexCore;
}

app Dexp {
    actor DexPair;
}
