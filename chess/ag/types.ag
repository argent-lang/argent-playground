// Shared constants, state layouts, and helpers for the chess app.

const byte WHITE = 0x00;
const byte BLACK = 0x01;

const byte LIVE = 0x00;
const byte WWIN = 0x01;
const byte BWIN = 0x02;
const byte DRAW = 0x03;

const byte CLEAR = 0x00;
const byte OFFER = 0x01;
const byte CLAIM = 0x02;
const byte SURRENDER = 0x03;
const byte ACCEPT = 0x04;

const byte CLAIMED = 0x01;
const byte DEFENSE = 0x02;
const byte NORMAL = 0x03;
const byte WOFFER = 0x04;
const byte BOFFER = 0x05;

// Board indices use 0..63; 64 represents the absence of a square.
// These bounded bytes stay in the nonnegative signed-byte range, so use signed(...)
// only where an integer is required for arithmetic or indexing.
const byte OFFBOARD = 0x40;

state LeagueState {
    int base_rating;
    byte[32] admin;
}

state PlayerState {
    byte[32] owner;
    byte[32] player_id;
    int open_games;
    int rating;
    int games;
    int wins;
    int draws;
    int losses;
}

// Mux and every move worker share this exact durable game-state layout.
state GameState {
    byte[32] white_player;
    byte[32] black_player;
    byte[64] board;
    byte turn;
    byte status;
    int move_timeout;
    byte[4] castle_rights;
    byte en_passant_idx;
    byte pending_src_idx;
    byte pending_dst_idx;
    byte pending_promo;
    byte recent_castle;
    byte draw_state;
}

state SettleState {
    byte[32] white_player;
    byte[32] black_player;
    byte status;
}

fn player_ref(byte[32] owner_, byte[32] player_id_) -> byte[32] {
    return blake2b(byte[](owner_ + player_id_));
}

fn abs_int(int value_) -> int {
    int result_ = value_;
    if (value_ < 0) {
        result_ = 0 - value_;
    }
    return result_;
}

fn timeout_status(byte turn_, byte draw_state_) -> byte {
    byte status_ = WWIN;
    if (turn_ == WHITE) {
        status_ = BWIN;
    }
    if (draw_state_ == CLAIMED) {
        status_ = DRAW;
    }
    return status_;
}
