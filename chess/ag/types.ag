// Shared constants, state layouts, and helpers for the chess app.

const int WHITE = 0;
const int BLACK = 1;

const int LIVE = 0;
const int WWIN = 1;
const int BWIN = 2;
const int DRAW = 3;

const int CLEAR = 0;
const int OFFER = 1;
const int CLAIM = 2;
const int SURRENDER = 3;
const int ACCEPT = 4;

const int CLAIMED = 1;
const int DEFENSE = 2;
const int NORMAL = 3;
const int WOFFER = 4;
const int BOFFER = 5;

state LeagueState {
    int base_rating;
    byte[32] admin;
}

state PlayerState {
    byte[32] owner;
    byte[32] player_id;
    int open_games;
    int rating;
    int games;
    int wins;
    int draws;
    int losses;
}

// Mux and every move worker share this exact durable game-state layout.
state GameState {
    byte[32] white_player;
    byte[32] black_player;
    byte[64] board;
    int turn;
    int status;
    int move_timeout;
    byte[4] castle_rights;
    int en_passant_idx;
    int pending_src_idx;
    int pending_dst_idx;
    int pending_promo;
    int recent_castle;
    int draw_state;
}

state SettleState {
    byte[32] white_player;
    byte[32] black_player;
    int status;
}

fn player_ref(byte[32] owner_, byte[32] player_id_) -> byte[32] {
    return blake2b(byte[](owner_ + player_id_));
}

fn abs_int(int value_) -> int {
    int result_ = value_;
    if (value_ < 0) {
        result_ = 0 - value_;
    }
    return result_;
}

fn timeout_status(int turn_, int draw_state_) -> int {
    int status_ = WWIN;
    if (turn_ == WHITE) {
        status_ = BWIN;
    }
    if (draw_state_ == CLAIMED) {
        status_ = DRAW;
    }
    return status_;
}
