                    next_status = WWIN;
                } else {
                    next_status = BWIN;
                }
            }
            if (effective_turn == BLACK && target_num == 6) {
                if (turn == WHITE) {
                    next_status = WWIN;
                } else {
                    next_status = BWIN;
                }
            }
        } else {
            if (turn == WHITE && target_num == 14) {
                next_status = WWIN;
            }
