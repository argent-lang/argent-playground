pragma silverscript ^0.1.0;

contract CastleChallengePrep(byte[32] gen__init_player_template, byte[32] gen__init_settle_template, byte[32] gen__init_mux_template, byte[256] gen__init_mux_routes, byte[32] init_white_player, byte[32] init_black_player, byte[64] init_board, byte init_turn, byte init_status, int init_move_timeout, byte[4] init_castle_rights, byte init_en_passant_idx, byte init_pending_src_idx, byte init_pending_dst_idx, byte init_pending_promo, byte init_recent_castle, byte init_draw_state) {
    struct LeagueState {
        int base_rating;
        byte[32] admin;
    }

    struct PlayerState {
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int rating;
        int games;
        int wins;
        int draws;
        int losses;
    }

    struct GameState {
        byte[32] white_player;
        byte[32] black_player;
        byte[64] board;
        byte turn;
        byte status;
        int move_timeout;
        byte[4] castle_rights;
        byte en_passant_idx;
        byte pending_src_idx;
        byte pending_dst_idx;
        byte pending_promo;
        byte recent_castle;
        byte draw_state;
    }

    struct SettleState {
        byte[32] white_player;
        byte[32] black_player;
        byte status;
    }

    struct Gen__SettleState {
        byte[32] gen__mux_template;
        byte[32] gen__player_template;
        byte[32] gen__settle_template;
        byte[32] gen__mux_routes_digest;
        byte[32] white_player;
        byte[32] black_player;
        byte status;
    }

    byte[32] gen__player_template = gen__init_player_template;

    byte[32] gen__settle_template = gen__init_settle_template;

    byte[32] gen__mux_template = gen__init_mux_template;

    byte[256] gen__mux_routes = gen__init_mux_routes;

    byte[32] white_player = init_white_player;

    byte[32] black_player = init_black_player;

    byte[64] board = init_board;

    byte turn = init_turn;

    byte status = init_status;

    int move_timeout = init_move_timeout;

    byte[4] castle_rights = init_castle_rights;

    byte en_passant_idx = init_en_passant_idx;

    byte pending_src_idx = init_pending_src_idx;

    byte pending_dst_idx = init_pending_dst_idx;

    byte pending_promo = init_pending_promo;

    byte recent_castle = init_recent_castle;

    byte draw_state = init_draw_state;

    byte constant WHITE = 0;

    byte constant BLACK = 1;

    byte constant LIVE = 0;

    byte constant WWIN = 1;

    byte constant BWIN = 2;

    byte constant DRAW = 3;

    byte constant CLEAR = 0;

    byte constant OFFER = 1;

    byte constant CLAIM = 2;

    byte constant SURRENDER = 3;

    byte constant ACCEPT = 4;

    byte constant CLAIMED = 1;

    byte constant DEFENSE = 2;

    byte constant NORMAL = 3;

    byte constant WOFFER = 4;

    byte constant BOFFER = 5;

    byte constant OFFBOARD = 64;

    function player_ref(byte[32] gen__glob_owner, byte[32] gen__glob_player_id): byte[32] {
        return(blake2b(byte[](gen__glob_owner + gen__glob_player_id)));
    }

    function abs_int(int gen__glob_value): int {
        int gen__glob_result = gen__glob_value;
        if (gen__glob_value < 0) {
            gen__glob_result = 0 - gen__glob_value;
        }
        return(gen__glob_result);
    }

    function timeout_status(byte gen__glob_turn, byte gen__glob_draw_state): byte {
        byte gen__glob_status = WWIN;
        if (gen__glob_turn == WHITE) {
            gen__glob_status = BWIN;
        }
        if (gen__glob_draw_state == CLAIMED) {
            gen__glob_status = DRAW;
        }
        return(gen__glob_status);
    }

    function invocation_uid(byte[] gen__glob_domain): byte[32] {
        require(gen__glob_domain.length > 0);
        byte[36] gen__glob_outpoint = byte[36](OpOutpointTxId(this.activeInputIndex) + OpOutpointIndex(this.activeInputIndex) as byte[4]);
        return(blake2bWithKey(byte[](gen__glob_outpoint), gen__glob_domain));
    }

    entry apply(int target, byte[] gen__target_prefix, byte[] gen__target_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(status == LIVE);
        require(draw_state == NORMAL);
        require(signed(recent_castle) >= 1 && signed(recent_castle) <= 4);
        int from_idx = signed(pending_src_idx);
        int to_idx = signed(pending_dst_idx);
        require(from_idx != to_idx);
        byte[64] prev_board = board;
        bool is_white_castle = recent_castle == 1 || recent_castle == 2;
        bool is_king_side = recent_castle == 1 || recent_castle == 3;
        int row_base = 0;
        byte king_piece = byte(6);
        byte rook_piece = byte(4);
        if (!is_white_castle) {
            row_base = 56;
            king_piece = byte(14);
            rook_piece = byte(12);
        }
        int start_idx = row_base + 4;
        int transit_idx = row_base + 3;
        int dest_idx = row_base + 2;
        if (is_king_side) {
            transit_idx = row_base + 5;
            dest_idx = row_base + 6;
        }
        int phase = 0;
        if (to_idx == start_idx) {
            phase = 1;
        } else {
            if (to_idx == transit_idx) {
                phase = 2;
            } else {
                if (to_idx == dest_idx) {
                    phase = 3;
                }
            }
        }
        require(phase != 0);
        byte empty_piece = byte(0);
        int a = row_base;
        int b = row_base + 2;
        int c = row_base + 3;
        int d = row_base + 4;
        byte va = empty_piece;
        byte vb = king_piece;
        byte vc = rook_piece;
        byte vd = empty_piece;
        if (is_king_side) {
            a = row_base + 4;
            b = row_base + 5;
            c = row_base + 6;
            d = row_base + 7;
            va = empty_piece;
            vb = rook_piece;
            vc = king_piece;
            vd = empty_piece;
            if (phase == 1) {
                va = king_piece;
                vb = empty_piece;
                vc = empty_piece;
                vd = rook_piece;
            } else {
                if (phase == 2) {
                    va = empty_piece;
                    vb = king_piece;
                    vc = empty_piece;
                    vd = rook_piece;
                }
            }
        } else {
            if (phase == 1) {
                va = rook_piece;
                vb = empty_piece;
                vc = empty_piece;
                vd = king_piece;
            } else {
                if (phase == 2) {
                    va = rook_piece;
                    vb = empty_piece;
                    vc = king_piece;
                    vd = empty_piece;
                }
            }
        }
        byte[] prefix = prev_board.slice(0, a);
        byte[] mid_ab = prev_board.slice(a + 1, b);
        byte[] mid_bc = prev_board.slice(b + 1, c);
        byte[] mid_cd = prev_board.slice(c + 1, d);
        byte[] suffix = prev_board.slice(d + 1, 64);
        byte[64] proof_board = byte[64](prefix + byte[1](va) + mid_ab + byte[1](vb) + mid_bc + byte[1](vc) + mid_cd + byte[1](vd) + suffix);
        int from_y = from_idx / 8;
        int from_x = from_idx % 8;
        int to_y = to_idx / 8;
        int to_x = to_idx % 8;
        int dx = to_x - from_x;
        int dy = to_y - from_y;
        int abs_dx = abs_int(dx);
        int abs_dy = abs_int(dy);
        int moving_num = signed(proof_board[from_idx]);
        if (moving_num == 1 || moving_num == 9) {
            require(target == 0);
        } else {
            if (moving_num == 2 || moving_num == 10) {
                require(target == 1);
            } else {
                if (moving_num == 3 || moving_num == 11) {
                    require(abs_dx == abs_dy && abs_dx != 0);
                    require(target == 4);
                } else {
                    if (moving_num == 4 || moving_num == 12) {
                        if (dx == 0 && dy != 0) {
                            require(target == 2);
                        } else {
                            require(dy == 0 && dx != 0);
                            require(target == 3);
                        }
                    } else {
                        if (moving_num == 5 || moving_num == 13) {
                            if (dx == 0 && dy != 0) {
                                require(target == 2);
                            } else {
                                if (dy == 0 && dx != 0) {
                                    require(target == 3);
                                } else {
                                    require(abs_dx == abs_dy && abs_dx != 0);
                                    require(target == 4);
                                }
                            }
                        } else {
                            require(moving_num == 6 || moving_num == 14);
                            require(target == 5);
                        }
                    }
                }
            }
        }
        GameState next_state = GameState {white_player: white_player, black_player: black_player, board: proof_board, turn: turn, status: status, move_timeout: move_timeout, castle_rights: castle_rights, en_passant_idx: OFFBOARD, pending_src_idx: pending_src_idx, pending_dst_idx: pending_dst_idx, pending_promo: CLEAR, recent_castle: recent_castle, draw_state: draw_state};
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        State gen__state_next_state = State {gen__player_template: gen__player_template, gen__settle_template: gen__settle_template, gen__mux_template: gen__mux_template, gen__mux_routes: gen__mux_routes, white_player: next_state.white_player, black_player: next_state.black_player, board: next_state.board, turn: next_state.turn, status: next_state.status, move_timeout: next_state.move_timeout, castle_rights: next_state.castle_rights, en_passant_idx: next_state.en_passant_idx, pending_src_idx: next_state.pending_src_idx, pending_dst_idx: next_state.pending_dst_idx, pending_promo: next_state.pending_promo, recent_castle: next_state.recent_castle, draw_state: next_state.draw_state};
        int gen__target_selector = target;
        require(gen__target_selector >= 0);
        require(gen__target_selector < 8);
        byte[32] gen__target_template = byte[32](gen__mux_routes.slice(gen__target_selector * 32, gen__target_selector * 32 + 32));
        validateOutputStateWithTemplate(gen__next_output_idx, gen__state_next_state, gen__target_prefix, gen__target_suffix, gen__target_template);
    }

    entry timeout(byte[] gen__settle_prefix, byte[] gen__settle_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(status == LIVE);
        require(this.ageDaa >= move_timeout);
        SettleState next_state = SettleState {white_player: white_player, black_player: black_player, status: timeout_status(turn, draw_state)};
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        Gen__SettleState gen__state_next_gen__settle_state = Gen__SettleState {gen__mux_template: gen__mux_template, gen__player_template: gen__player_template, gen__settle_template: gen__settle_template, gen__mux_routes_digest: blake3(byte[](gen__mux_routes)), white_player: next_state.white_player, black_player: next_state.black_player, status: next_state.status};
        validateOutputStateWithTemplate(gen__next_output_idx, gen__state_next_gen__settle_state, gen__settle_prefix, gen__settle_suffix, gen__settle_template);
    }
}
