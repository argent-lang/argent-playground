pragma silverscript ^0.1.0;

contract Settle(byte[32] gen__init_mux_template, byte[32] gen__init_player_template, byte[32] gen__init_settle_template, byte[32] gen__init_mux_routes_digest, byte[32] init_white_player, byte[32] init_black_player, byte init_status) {
    struct LeagueState {
        int base_rating;
        byte[32] admin;
    }

    struct PlayerState {
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int rating;
        int games;
        int wins;
        int draws;
        int losses;
    }

    struct GameState {
        byte[32] white_player;
        byte[32] black_player;
        byte[64] board;
        byte turn;
        byte status;
        int move_timeout;
        byte[4] castle_rights;
        byte en_passant_idx;
        byte pending_src_idx;
        byte pending_dst_idx;
        byte pending_promo;
        byte recent_castle;
        byte draw_state;
    }

    struct SettleState {
        byte[32] white_player;
        byte[32] black_player;
        byte status;
    }

    struct Gen__PlayerState {
        byte[32] gen__mux_template;
        byte[32] gen__player_template;
        byte[32] gen__settle_template;
        byte[32] gen__mux_routes_digest;
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int rating;
        int games;
        int wins;
        int draws;
        int losses;
    }

    byte[32] gen__mux_template = gen__init_mux_template;

    byte[32] gen__player_template = gen__init_player_template;

    byte[32] gen__settle_template = gen__init_settle_template;

    byte[32] gen__mux_routes_digest = gen__init_mux_routes_digest;

    byte[32] white_player = init_white_player;

    byte[32] black_player = init_black_player;

    byte status = init_status;

    byte constant WHITE = 0;

    byte constant BLACK = 1;

    byte constant LIVE = 0;

    byte constant WWIN = 1;

    byte constant BWIN = 2;

    byte constant DRAW = 3;

    byte constant CLEAR = 0;

    byte constant OFFER = 1;

    byte constant CLAIM = 2;

    byte constant SURRENDER = 3;

    byte constant ACCEPT = 4;

    byte constant CLAIMED = 1;

    byte constant DEFENSE = 2;

    byte constant NORMAL = 3;

    byte constant WOFFER = 4;

    byte constant BOFFER = 5;

    byte constant OFFBOARD = 64;

    function player_ref(byte[32] gen__glob_owner, byte[32] gen__glob_player_id): byte[32] {
        return(blake2b(byte[](gen__glob_owner + gen__glob_player_id)));
    }

    function abs_int(int gen__glob_value): int {
        int gen__glob_result = gen__glob_value;
        if (gen__glob_value < 0) {
            gen__glob_result = 0 - gen__glob_value;
        }
        return(gen__glob_result);
    }

    function timeout_status(byte gen__glob_turn, byte gen__glob_draw_state): byte {
        byte gen__glob_status = WWIN;
        if (gen__glob_turn == WHITE) {
            gen__glob_status = BWIN;
        }
        if (gen__glob_draw_state == CLAIMED) {
            gen__glob_status = DRAW;
        }
        return(gen__glob_status);
    }

    function invocation_uid(byte[] gen__glob_domain): byte[32] {
        require(gen__glob_domain.length > 0);
        byte[36] gen__glob_outpoint = byte[36](OpOutpointTxId(this.activeInputIndex) + OpOutpointIndex(this.activeInputIndex) as byte[4]);
        return(blake2bWithKey(byte[](gen__glob_outpoint), gen__glob_domain));
    }

    entry settle(int gen__player_prefix_len, int gen__player_suffix_len) {
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) == 3);
        require(OpCovInputIdx(gen__cov_id, 0) == this.activeInputIndex);
        int gen__white_in_input_idx = OpCovInputIdx(gen__cov_id, 1);
        Gen__PlayerState gen__white_in_state = readInputStateWithTemplate(gen__white_in_input_idx, gen__player_prefix_len, gen__player_suffix_len, gen__player_template);
        int gen__black_in_input_idx = OpCovInputIdx(gen__cov_id, 2);
        Gen__PlayerState gen__black_in_state = readInputStateWithTemplate(gen__black_in_input_idx, gen__player_prefix_len, gen__player_suffix_len, gen__player_template);
        require(OpAuthOutputCount(this.activeInputIndex) == 2);
        int gen__white_out_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        int gen__black_out_output_idx = OpAuthOutputIdx(this.activeInputIndex, 1);
        require(OpCovOutputCount(gen__cov_id) == OpAuthOutputCount(this.activeInputIndex));
        require(status != LIVE);
        require(player_ref(gen__white_in_state.owner, gen__white_in_state.player_id) == white_player);
        require(player_ref(gen__black_in_state.owner, gen__black_in_state.player_id) == black_player);
        int white_output_value = tx.inputs[gen__white_in_input_idx].value;
        int black_output_value = tx.inputs[gen__black_in_input_idx].value;
        int white_wins = gen__white_in_state.wins;
        int white_draws = gen__white_in_state.draws;
        int white_losses = gen__white_in_state.losses;
        int black_wins = gen__black_in_state.wins;
        int black_draws = gen__black_in_state.draws;
        int black_losses = gen__black_in_state.losses;
        int white_actual = 0;
        int black_actual = 0;
        int white_expected = 500;
        int black_expected = 500;
        if (status == WWIN) {
            white_wins = white_wins + 1;
            black_losses = black_losses + 1;
            white_actual = 1000;
            white_output_value = white_output_value + tx.inputs[this.activeInputIndex].value;
        } else {
            if (status == BWIN) {
                black_wins = black_wins + 1;
                white_losses = white_losses + 1;
                black_actual = 1000;
                black_output_value = black_output_value + tx.inputs[this.activeInputIndex].value;
            } else {
                require(status == DRAW);
                white_draws = white_draws + 1;
                black_draws = black_draws + 1;
                white_actual = 500;
                black_actual = 500;
                int white_share = tx.inputs[this.activeInputIndex].value / 2;
                int black_share = tx.inputs[this.activeInputIndex].value - white_share;
                white_output_value = white_output_value + white_share;
                black_output_value = black_output_value + black_share;
            }
        }
        int diff = gen__black_in_state.rating - gen__white_in_state.rating;
        int abs_diff = abs_int(diff);
        int favored_expected = 990;
        if (abs_diff < 800) {
            favored_expected = 970;
            if (abs_diff < 600) {
                favored_expected = 910;
                if (abs_diff < 400) {
                    favored_expected = 820;
                    if (abs_diff < 250) {
                        favored_expected = 700;
                        if (abs_diff < 150) {
                            favored_expected = 600;
                            if (abs_diff < 75) {
                                favored_expected = 500;
                            }
                        }
                    }
                }
            }
        }
        if (diff < 0) {
            white_expected = favored_expected;
            black_expected = 1000 - favored_expected;
        } else {
            if (diff > 0) {
                white_expected = 1000 - favored_expected;
                black_expected = favored_expected;
            }
        }
        int white_rating = gen__white_in_state.rating + 32 * (white_actual - white_expected) / 1000;
        int black_rating = gen__black_in_state.rating + 32 * (black_actual - black_expected) / 1000;
        require(gen__white_in_state.open_games > 0);
        require(gen__black_in_state.open_games > 0);
        PlayerState next_white = PlayerState {owner: gen__white_in_state.owner, player_id: gen__white_in_state.player_id, open_games: gen__white_in_state.open_games - 1, rating: white_rating, games: gen__white_in_state.games + 1, wins: white_wins, draws: white_draws, losses: white_losses};
        PlayerState next_black = PlayerState {owner: gen__black_in_state.owner, player_id: gen__black_in_state.player_id, open_games: gen__black_in_state.open_games - 1, rating: black_rating, games: gen__black_in_state.games + 1, wins: black_wins, draws: black_draws, losses: black_losses};
        require(tx.outputs[gen__white_out_output_idx].value == white_output_value);
        require(tx.outputs[gen__black_out_output_idx].value == black_output_value);
        Gen__PlayerState gen__state_white_out_gen__player_state = Gen__PlayerState {gen__mux_template: gen__mux_template, gen__player_template: gen__player_template, gen__settle_template: gen__settle_template, gen__mux_routes_digest: gen__mux_routes_digest, owner: next_white.owner, player_id: next_white.player_id, open_games: next_white.open_games, rating: next_white.rating, games: next_white.games, wins: next_white.wins, draws: next_white.draws, losses: next_white.losses};
        validateOutputStateWithInputTemplate(gen__white_out_output_idx, gen__state_white_out_gen__player_state, gen__white_in_input_idx, gen__player_prefix_len, gen__player_suffix_len, gen__player_template);
        Gen__PlayerState gen__state_black_out_gen__player_state = Gen__PlayerState {gen__mux_template: gen__mux_template, gen__player_template: gen__player_template, gen__settle_template: gen__settle_template, gen__mux_routes_digest: gen__mux_routes_digest, owner: next_black.owner, player_id: next_black.player_id, open_games: next_black.open_games, rating: next_black.rating, games: next_black.games, wins: next_black.wins, draws: next_black.draws, losses: next_black.losses};
        validateOutputStateWithInputTemplate(gen__black_out_output_idx, gen__state_black_out_gen__player_state, gen__white_in_input_idx, gen__player_prefix_len, gen__player_suffix_len, gen__player_template);
    }
}
