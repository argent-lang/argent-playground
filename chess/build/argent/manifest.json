          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Vert",
      "state": "GameState",
      "sil": "sil/Vert.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Horiz",
      "state": "GameState",
      "sil": "sil/Horiz.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Diag",
      "state": "GameState",
      "sil": "sil/Diag.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "King",
      "state": "GameState",
      "sil": "sil/King.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Castle",
      "state": "GameState",
      "sil": "sil/Castle.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "CastleChallengePrep",
      "state": "GameState",
      "sil": "sil/CastleChallengePrep.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Move"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "target", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Settle",
      "state": "SettleState",
      "sil": "sil/Settle.sil",
      "entries": [
        {
          "name": "settle",
          "kind": "leader",
          "emits": { "kind": "outputs", "outputs": [{ "name": "white_out", "auth_index": 0, "actors": ["Player"] }, { "name": "black_out", "auth_index": 1, "actors": ["Player"] }] },
          "consumes": [{ "name": "white_in", "actor": "Player" }, { "name": "black_in", "actor": "Player" }],
          "routes": [{ "output": "white_out", "actor": "Player", "state": "next_white" }, { "output": "black_out", "actor": "Player", "state": "next_black" }]
        }
      ]
    }
  ]
}
