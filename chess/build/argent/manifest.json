{
  "app": "Chess",
  "root": "ag/app.ag",
  "modules": [
    "ag/app.ag",
    "ag/types.ag",
    "ag/outer.ag",
    "ag/game.ag"
  ],
  "templates": [
    { "actor": "League", "symbol": "gen__league_template", "hash": null },
    { "actor": "Player", "symbol": "gen__player_template", "hash": null },
    { "actor": "Mux", "symbol": "gen__mux_template", "hash": null },
    { "actor": "Pawn", "symbol": "gen__pawn_template", "hash": null },
    { "actor": "Knight", "symbol": "gen__knight_template", "hash": null },
    { "actor": "Vert", "symbol": "gen__vert_template", "hash": null },
    { "actor": "Horiz", "symbol": "gen__horiz_template", "hash": null },
    { "actor": "Diag", "symbol": "gen__diag_template", "hash": null },
    { "actor": "King", "symbol": "gen__king_template", "hash": null },
    { "actor": "Castle", "symbol": "gen__castle_template", "hash": null },
    { "actor": "CastleChallengePrep", "symbol": "gen__castle_challenge_prep_template", "hash": null },
    { "actor": "Settle", "symbol": "gen__settle_template", "hash": null }
  ],
  "actors": [
    {
      "name": "League",
      "state": "LeagueState",
      "sil": "sil/League.sil",
      "entries": [
        {
          "name": "register_player",
          "kind": "leader",
          "emits": { "kind": "outputs", "outputs": [{ "name": "league", "auth_index": 0, "actors": ["League"] }, { "name": "player", "auth_index": 1, "actors": ["Player"] }] },
          "consumes": [],
          "routes": [{ "output": "league", "actor": "League", "state": "self.state" }, { "output": "player", "actor": "Player", "state": "next_player" }]
        },
        {
          "name": "rebalance",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["League"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "League", "state": "self.state" }]
        },
        {
          "name": "fork",
          "kind": "leader",
          "emits": { "kind": "outputs", "outputs": [{ "name": "left", "auth_index": 0, "actors": ["League"] }, { "name": "right", "auth_index": 1, "actors": ["League"] }] },
          "consumes": [],
          "routes": [{ "output": "left", "actor": "League", "state": "self.state" }, { "output": "right", "actor": "League", "state": "self.state" }]
        }
      ]
    },
    {
      "name": "Player",
      "state": "PlayerState",
      "sil": "sil/Player.sil",
      "entries": [
        {
          "name": "start_game",
          "kind": "leader",
          "emits": { "kind": "outputs", "outputs": [{ "name": "self_out", "auth_index": 0, "actors": ["Player"] }, { "name": "other_out", "auth_index": 1, "actors": ["Player"] }, { "name": "game", "auth_index": 2, "actors": ["Mux"] }] },
          "consumes": [{ "name": "other", "actor": "Player" }],
          "routes": [{ "output": "self_out", "actor": "Player", "state": "next_self" }, { "output": "other_out", "actor": "Player", "state": "next_other" }, { "output": "game", "actor": "Mux", "state": "next_game" }]
        },
        {
          "name": "delegate_start_game",
          "kind": "delegate",
          "emits": { "kind": "none" },
          "consumes": [{ "name": "leader", "actor": "Player" }],
          "routes": []
        },
        {
          "name": "delegate_settle",
          "kind": "delegate",
          "emits": { "kind": "none" },
          "consumes": [{ "name": "settlement", "actor": "Settle" }],
          "routes": []
        },
        {
          "name": "rebalance",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Player"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Player", "state": "self.state" }]
        },
        {
          "name": "retire",
          "kind": "leader",
          "emits": { "kind": "none" },
          "consumes": [],
          "routes": []
        }
      ]
    },
    {
      "name": "Mux",
      "state": "GameState",
      "sil": "sil/Mux.sil",
      "entries": [
        {
          "name": "route",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Move"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "target", "state": "next_state" }]
        },
        {
          "name": "terminate",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        },
        {
          "name": "settle",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Pawn",
      "state": "GameState",
      "sil": "sil/Pawn.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Settle"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Settle", "state": "next_state" }]
        }
      ]
    },
    {
      "name": "Knight",
      "state": "GameState",
      "sil": "sil/Knight.sil",
      "entries": [
        {
          "name": "apply",
          "kind": "leader",
          "emits": { "kind": "one", "actors": ["Mux"] },
          "consumes": [],
          "routes": [{ "output": null, "actor": "Mux", "state": "next_state" }]
        },
        {
          "name": "timeout",
